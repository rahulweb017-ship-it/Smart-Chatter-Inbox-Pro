<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sci" model="ir.module.category">
        <field name="name">Smart Chatter Inbox</field>
        <field name="sequence">40</field>
        <field name="parent_id" ref="base.module_category_sales"/>
    </record>

    <!-- Product access only: grants no CRM rights. Lead visibility stays with native CRM rules. -->
    <record id="group_sci_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sci"/>
        <field name="comment">Can use the Smart Chatter Inbox queue on CRM leads they are already allowed to see.</field>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
