<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_sci" model="res.groups.privilege">
        <field name="name">Smart Chatter Inbox</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <!-- Product access only: grants no CRM rights. Lead visibility stays with native CRM rules. -->
    <record id="group_sci_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_sci"/>
        <field name="comment">Can use the Smart Chatter Inbox queue on CRM leads they are already allowed to see.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
